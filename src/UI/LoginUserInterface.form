<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="UI.LoginUserInterface">
  <grid id="27dc6" binding="loginPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="230" y="104" width="2121" height="499"/>
    </constraints>
    <properties>
      <background color="-1"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="61c21" binding="leftPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="West"/>
        <properties>
          <background color="-339903"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="5aabc" class="javax.swing.JLabel">
            <constraints border-constraint="West"/>
            <properties>
              <icon value="icongilid.png"/>
              <preferredSize width="350" height="400"/>
              <text value=""/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="2615e" binding="rightPanel" layout-manager="GridLayoutManager" row-count="11" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="12">
        <margin top="40" left="70" bottom="40" right="50"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="b1d09" class="javax.swing.JButton" binding="loginButton" default-binding="true">
            <constraints>
              <grid row="9" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="40"/>
              </grid>
            </constraints>
            <properties>
              <background color="-1"/>
              <font name="Inter" size="16" style="1"/>
              <horizontalTextPosition value="0"/>
              <text value="Login"/>
            </properties>
          </component>
          <vspacer id="5dbaa">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <vspacer id="66845">
            <constraints>
              <grid row="10" column="0" row-span="1" col-span="3" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <vspacer id="5ec52">
            <constraints>
              <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <vspacer id="96de4">
            <constraints>
              <grid row="8" column="0" row-span="1" col-span="3" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <component id="b8565" class="javax.swing.JLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="10" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Inter" size="16" style="1"/>
              <text value="Username"/>
            </properties>
          </component>
          <component id="f36b4" class="javax.swing.JLabel">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="10" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Inter" size="16" style="1"/>
              <text value="Password"/>
            </properties>
          </component>
          <component id="a1e35" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Inter" size="26" style="1"/>
              <text value="Login"/>
            </properties>
          </component>
          <component id="a7d71" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Inter" size="14" style="0"/>
              <foreground color="-10197916"/>
              <text value="Welcome Back! Please login to proceed."/>
            </properties>
          </component>
          <grid id="c54dd" binding="passwordWrapper" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="3" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="300" height="40"/>
              </grid>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="513cd" class="javax.swing.JPasswordField" binding="passwordField">
                <constraints border-constraint="Center"/>
                <properties>
                  <font name="Inter" size="16" style="0"/>
                </properties>
              </component>
              <component id="9293f" class="javax.swing.JLabel" binding="eyelabel">
                <constraints border-constraint="East"/>
                <properties>
                  <icon value="open_20x20.png"/>
                  <preferredSize width="30" height="50"/>
                  <text value=""/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="a601b" binding="userWrapper" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="3" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="300" height="40"/>
              </grid>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="8225d" class="javax.swing.JTextField" binding="usernameField">
                <constraints border-constraint="Center"/>
                <properties>
                  <font name="Inter" size="16" style="0"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
